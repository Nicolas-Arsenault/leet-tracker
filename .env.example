NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
OWNER_EMAIL=YOUR_GITHUB_ACCOUNT_EMAIL

# Optional, local-only: enables the full LeetCode solved-problem crawl.
# Keep these server-side and never expose them with a NEXT_PUBLIC_ prefix.
LEETCODE_SESSION=YOUR_LEETCODE_SESSION_COOKIE
LEETCODE_CSRF_TOKEN=YOUR_LEETCODE_CSRF_TOKEN
